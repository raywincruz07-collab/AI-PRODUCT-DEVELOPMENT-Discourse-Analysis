# Database
DB_BACKEND=sqlite
DB_PATH=discourse.db

# PostgreSQL optional configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=discourse
DB_HOST=localhost
DB_PORT=5432

# 4chan public boards
FOURCHAN_BOARDS=pol,news,biz

# Mastodon optional configuration
MASTODON_TOKEN=
MASTODON_HASHTAGS=politics,news,election,media
MASTODON_KEYWORDS=immigration,economy,climate

# Truth Social optional configuration - do not commit real credentials
TRUTHSOCIAL_USERNAME=
TRUTHSOCIAL_PASSWORD=
TRUTHSOCIAL_TOKEN=
TRUTHSOCIAL_HASHTAGS=politics,news,election,media

# Server
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Evidence-based QA
ANTHROPIC_API_KEY=
QA_MAX_POSTS=20
QA_MIN_RELEVANT_POSTS=5
QA_CONFIDENCE_THRESHOLD=40
